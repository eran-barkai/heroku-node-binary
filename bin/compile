#!/usr/bin/env bash
# Hand the Node.js buildpack a local copy of Node 22.23.4.
#
# `engines.node` is `22.x`, which resolves to 22.23.4. The Node.js buildpack
# downloads that tarball from nodejs.org with a 120-second cap and retries
# from scratch. On 2026-10-26, after Chrome 156.0.8078.47, that finished.
# After Chrome for Testing moved to 156.0.8078.73 the same download stalls
# partway and the build dies before `pnpm install`. A web dyno can still fetch
# nodejs.org at full speed, so the stall is the build dyno. This buildpack
# ships the official tarball (checksum below) and points NODE_BINARY_URL at
# the file, which is the buildpack's supported way to skip that download.
set -euo pipefail

BUILD_DIR="${1:?}"
ENV_DIR="${3:?}"

VERSION="22.23.4"
SHA256="b8492284c76a54baf58d61668dd0e41ee0fc98adabf9503d30f05d08f55b4406"
NAME="node-v${VERSION}-linux-x64.tar.gz"
BP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
VENDORED="${BP_DIR}/vendor/${NAME}"
LOCAL="/tmp/${NAME}"

if [[ ! -f "${VENDORED}" ]]; then
	echo "Vendored Node.js tarball is missing: ${VENDORED}" >&2
	exit 1
fi

echo "Checking vendored Node.js ${VERSION}"
echo "${SHA256}  ${VENDORED}" | sha256sum -c -
cp "${VENDORED}" "${LOCAL}"

# No trailing newline: Heroku uses the file bytes as the value.
printf '%s' "file://${LOCAL}" > "${ENV_DIR}/NODE_BINARY_URL"

mkdir -p "${BUILD_DIR}/.profile.d"
printf '%s\n' 'unset NODE_BINARY_URL' > "${BUILD_DIR}/.profile.d/unset-node-binary-url.sh"
echo "Node.js ${VERSION} will be installed from the vendored tarball"
