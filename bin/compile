#!/usr/bin/env bash
# Fetch the Node binary the app's `engines.node` of `22.x` resolves to, verify
# the official checksum, and hand the file to the Node.js buildpack.
#
# That buildpack downloads nodejs.org with a 120s cap and retries from scratch.
# On 2026-10-26 that finished. After Chrome for Testing moved from
# 156.0.8078.47 to 156.0.8078.73 the same 56 MB download stalls partway and
# the build dies before `pnpm install`. A cached file skips the network on
# the next deploy.
set -euo pipefail

BUILD_DIR="${1:?}"
CACHE_DIR="${2:?}"
ENV_DIR="${3:?}"

VERSION="22.23.4"
SHA256="b8492284c76a54baf58d61668dd0e41ee0fc98adabf9503d30f05d08f55b4406"
NAME="node-v${VERSION}-linux-x64.tar.gz"
URL="https://nodejs.org/dist/v${VERSION}/${NAME}"
CACHED="${CACHE_DIR}/${NAME}"
LOCAL="/tmp/${NAME}"

mkdir -p "${CACHE_DIR}"

verify() {
	echo "${SHA256}  ${1}" | sha256sum -c -
}

if [[ -f "${CACHED}" ]] && verify "${CACHED}"; then
	echo "Using cached Node.js ${VERSION}"
else
	echo "Downloading Node.js ${VERSION} (checksummed, up to 15 minutes)..."
	rm -f "${CACHED}"
	curl --location --fail --show-error \
		--retry 5 --retry-all-errors --retry-delay 3 \
		--connect-timeout 15 --max-time 900 \
		--continue-at - \
		-o "${CACHED}.partial" \
		"${URL}"
	mv "${CACHED}.partial" "${CACHED}"
	verify "${CACHED}"
fi

cp "${CACHED}" "${LOCAL}"
# The Node.js buildpack curls this and skips its own download. No trailing
# newline: Heroku uses the file bytes as the value.
printf '%s' "file://${LOCAL}" > "${ENV_DIR}/NODE_BINARY_URL"

mkdir -p "${BUILD_DIR}/.profile.d"
printf '%s\n' 'unset NODE_BINARY_URL' > "${BUILD_DIR}/.profile.d/unset-node-binary-url.sh"
